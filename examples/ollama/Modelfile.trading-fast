FROM qwen3:8b-q4_K_M

# Fast profile: smaller quantization and context window, tuned for quick
# iteration on the shallow-thinker analyst passes. See README.md for
# how these settings trade off against the accurate profile.
PARAMETER num_ctx 8192
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.05
PARAMETER num_predict 2048
