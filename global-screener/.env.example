# Copy to .env.local for local development.
# All variables are optional; the screener works with sensible defaults
# using free, unauthenticated Yahoo Finance data.

# Upstash Redis (free tier) — enables 10-minute TTL caching to avoid
# hammering upstream data APIs. Get these at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback data source when Yahoo Finance is rate-limited (800 calls/day free)
# https://twelvedata.com
TWELVE_DATA_API_KEY=

# Polling interval for the auto-refresh countdown, in milliseconds (default: 720000 = 12 min)
NEXT_PUBLIC_REFRESH_INTERVAL_MS=

# Row count above which inline sparklines are suppressed for performance
NEXT_PUBLIC_VIRTUAL_ROW_THRESHOLD=

# --- Engine integration (docs/DEPLOYMENT_INTEGRATION_PLAN.md Phase 2) ---
# Powers the /analyze and /reports pages via the server-side proxy at
# app/api/engine/[...path]/route.ts. Points at the TradingAgents engine API
# (api/main.py), which is deployed separately — see VERCEL_DEPLOYMENT.md.
# Leave both unset to run the screener standalone; /analyze and /reports will
# show a clear "engine not configured" message instead of failing silently.
#
# ENGINE_API_URL=http://localhost:9000
#
# Only needed if the engine has ENGINE_API_TOKEN set (see api/auth.py) — the
# proxy adds it server-side, so it is never sent to the browser.
# ENGINE_API_TOKEN=
