# Copy to .env.local for local development.
# All variables are optional; the screener works with sensible defaults
# using free, unauthenticated Yahoo Finance data.

# Upstash Redis (free tier) — enables 10-minute TTL caching to avoid
# hammering upstream data APIs. Get these at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback data source when Yahoo Finance is rate-limited (800 calls/day free)
# https://twelvedata.com
TWELVE_DATA_API_KEY=

# Polling interval for the auto-refresh countdown, in milliseconds (default: 720000 = 12 min)
NEXT_PUBLIC_REFRESH_INTERVAL_MS=

# Row count above which inline sparklines are suppressed for performance
NEXT_PUBLIC_VIRTUAL_ROW_THRESHOLD=

# --- Reserved for the engine integration (docs/DEPLOYMENT_INTEGRATION_PLAN.md Phase 2) ---
# Not yet used by anything in this app. Once the /analyze and /reports pages
# land, these will point the app/api/engine/* proxy at the TradingAgents
# engine API (api/main.py, deployed separately — see VERCEL_DEPLOYMENT.md).
# ENGINE_API_URL=
# ENGINE_API_TOKEN=
